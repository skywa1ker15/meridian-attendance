<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY: allows plain HTTP to a local backend (emulator 10.0.2.2, LAN IP, MockWebServer in
     instrumented tests). The release build uses src/main/res/xml/network_security_config.xml (TLS only). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
