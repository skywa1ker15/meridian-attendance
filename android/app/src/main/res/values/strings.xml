    <!-- Onboarding -->
    <string name="onboarding_step">Step %1$d of %2$d</string>
    <string name="ob_intro_title">How attendance works</string>
    <string name="ob_intro_body">Meridian Attendance uses your phone\'s location (and optionally your workplace Wi-Fi) to notice when you arrive at or leave your Meridian workplace. It then asks you to confirm. Nothing is recorded without your confirmation, and you are never clocked out automatically.\n\nWhy we need this (POPIA): the only purpose is recording your working time. Location is checked against your workplace boundary only when you arrive or leave; it is not used to track where you go. Detection data is kept according to Meridian\'s retention policy and is visible to you and authorised managers. You can withdraw permissions at any time in Settings and record attendance through manual requests instead.</string>
    <string name="ob_intro_cta">Set up permissions</string>
    <string name="ob_notif_title">Notifications</string>
    <string name="ob_notif_body">We notify you when an arrival or departure is detected so you can confirm it, and when a request is reviewed.</string>
    <string name="ob_location_title">Precise location</string>
    <string name="ob_location_body">Precise location lets the app tell whether you are inside your workplace boundary (about 150 m). Approximate location is not accurate enough.</string>
    <string name="ob_precise_needed_title">Precise location is off</string>
    <string name="ob_precise_needed_body">You allowed approximate location only. Please allow precise location so arrivals can be detected.</string>
    <string name="ob_background_title">Location all the time</string>
    <string name="ob_background_body">Arrivals and departures happen while the app is closed, so Android requires \"Allow all the time\". The app is only woken when you cross your workplace boundary; it does not track your route.</string>
    <string name="ob_background_settings_hint">In Settings, open Permissions → Location and choose \"Allow all the time\". Then come back here.</string>
    <string name="ob_background_needs_precise_title">Precise location first</string>
    <string name="ob_background_needs_precise_body">Go back one step and allow precise location first.</string>
    <string name="ob_battery_title">Battery optimisation</string>
    <string name="ob_battery_body">Some phones delay background work to save battery, which can make detection late or missed. In the list that opens, choose Meridian Attendance and select \"Don\'t optimise\" / \"Unrestricted\". The app uses very little battery: it only wakes on boundary crossings.</string>
    <string name="ob_battery_cta">Open battery settings</string>
    <string name="ob_wifi_title">Workplace Wi-Fi (optional)</string>
    <string name="ob_wifi_body">If your workplace uses Wi-Fi verification, the name of the Wi-Fi network you are connected to is sent with a detection as extra evidence. Other networks around you are never scanned or sent.</string>
    <string name="ob_turn_on_wifi">Turn on Wi-Fi</string>
    <string name="ob_turn_on_location">Turn on location</string>
    <string name="ob_done_title">You\'re all set</string>
    <string name="ob_done_body">Here is what the app can use. You can change this at any time from Profile → Permissions.</string>
    <string name="ob_finish">Go to my dashboard</string>
