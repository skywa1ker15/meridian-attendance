<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower (fullBackupContent). Tokens (Keystore-bound, unusable elsewhere), the database
     (attendance cache + outbox with location data) and detection state are never backed up. -->
<full-backup-content>
    <exclude domain="file" path="datastore/secure_tokens.preferences_pb" />
    <exclude domain="database" path="meridian_attendance.db" />
    <exclude domain="database" path="meridian_attendance.db-shm" />
    <exclude domain="database" path="meridian_attendance.db-wal" />
    <exclude domain="sharedpref" path="detection_state.xml" />
    <exclude domain="file" path="datastore/app_prefs.preferences_pb" />
</full-backup-content>
