#!/usr/bin/env bash
# Compiles and tests the Android-free part of the app with a plain kotlinc (no Gradle, no Android SDK):
#   * za.co.meridiangroup.attendance.core      (pure Kotlin: verification, debounce, outbox rules, time, validation…)
#   * data/remote/dto + data/remote/ApiJson.kt (kotlinx-serialization DTOs = the docs/API.md contract)
# and runs every @Test in app/src/test/.../core and .../data/remote through a tiny reflection runner.
# kotlinx-serialization runtime: taken from KOTLINX_SERIALIZATION_JARS or the Gradle distribution's lib/ folder
# (1.6.2 there vs 1.8.0 pinned for the app: the APIs used are identical). Exit code != 0 on any failure.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ANDROID_DIR="$(cd "$HERE/.." && pwd)"
KOTLINC_HOME="${KOTLINC_HOME:-/opt/kotlinc}"
KOTLINC="$KOTLINC_HOME/bin/kotlinc"
KOTLIN="$KOTLINC_HOME/bin/kotlin"
[ -x "$KOTLINC" ] || { echo "core-check: kotlinc not found at $KOTLINC (set KOTLINC_HOME)"; exit 2; }

PKG="za/co/meridiangroup/attendance"
MAIN="$ANDROID_DIR/app/src/main/kotlin/$PKG"
TEST="$ANDROID_DIR/app/src/test/kotlin/$PKG"
OUT="${CORE_CHECK_OUT:-$ANDROID_DIR/build/core-check}"
rm -rf "$OUT" && mkdir -p "$OUT/main" "$OUT/test" "$OUT/runner" "$OUT/junit-stub"

find_jar() { # $1 = glob under candidate dirs
  for d in ${GRADLE_HOME:-} /opt/gradle-8.14.3 /opt/gradle; do
    [ -d "$d/lib" ] && ls "$d"/lib/$1 2>/dev/null | head -1 && return 0
  done
  return 1
}
SER_JARS="${KOTLINX_SERIALIZATION_JARS:-}"
if [ -z "$SER_JARS" ]; then
  CORE_JAR="$(find_jar 'kotlinx-serialization-core-jvm-*.jar' || true)"
  JSON_JAR="$(find_jar 'kotlinx-serialization-json-jvm-*.jar' || true)"
  [ -n "$CORE_JAR" ] && [ -n "$JSON_JAR" ] || { echo "core-check: kotlinx-serialization jars not found (set KOTLINX_SERIALIZATION_JARS=core.jar:json.jar)"; exit 2; }
  SER_JARS="$CORE_JAR:$JSON_JAR"
fi
SER_PLUGIN="$KOTLINC_HOME/lib/kotlinx-serialization-compiler-plugin.jar"

MAIN_SRC=("$MAIN"/core/*.kt "$MAIN"/data/remote/dto/*.kt "$MAIN/data/remote/ApiJson.kt")
TEST_SRC=("$TEST"/core/*.kt "$TEST"/data/remote/DtoContractTest.kt "$TEST"/data/remote/AdminDtoContractTest.kt)

# Guard: these files must stay free of Android / Retrofit / OkHttp / Room imports.
FORBIDDEN='^import (android|androidx|com\.google|retrofit2|okhttp3|com\.jakewharton|kotlinx\.coroutines)'
if grep -nE "$FORBIDDEN" "${MAIN_SRC[@]}"; then
  echo "core-check: FORBIDDEN import in the Android-free sources listed above"; exit 1
fi

filter() { grep -v 'JAVA_TOOL_OPTIONS' >&2 || true; }
KT_TEST_JAR="$KOTLINC_HOME/lib/kotlin-test.jar"
KT_TEST_JUNIT_JAR="$KOTLINC_HOME/lib/kotlin-test-junit.jar"
COMMON=(-language-version 2.3 -jvm-target 17 "-Xplugin=$SER_PLUGIN")

echo "core-check: compiling ${#MAIN_SRC[@]} Android-free source files (warnings are errors)"
"$KOTLINC" "${COMMON[@]}" -Werror -cp "$SER_JARS" -d "$OUT/main" "${MAIN_SRC[@]}" 2> >(filter)

echo "core-check: compiling JUnit @Test annotation stub (sandbox has no JUnit jar; Gradle uses junit 4.13.2)"
"$KOTLINC" -language-version 2.3 -jvm-target 17 -d "$OUT/junit-stub" "$HERE/runner/junit-stub/org/junit/Test.kt" 2> >(filter)

echo "core-check: compiling ${#TEST_SRC[@]} test files"
"$KOTLINC" "${COMMON[@]}" -cp "$OUT/main:$SER_JARS:$KT_TEST_JAR:$KT_TEST_JUNIT_JAR:$OUT/junit-stub" -d "$OUT/test" "${TEST_SRC[@]}" 2> >(filter)

echo "core-check: compiling runner"
"$KOTLINC" -language-version 2.3 -jvm-target 17 -cp "$OUT/junit-stub" -d "$OUT/runner" "$HERE/runner/CoreTestRunner.kt" 2> >(filter)

echo "core-check: running tests"
# kotlin-test-junit is deliberately NOT on the runtime classpath, so kotlin.test uses its default asserter.
"$KOTLIN" -cp "$OUT/runner:$OUT/main:$SER_JARS:$OUT/junit-stub:$KT_TEST_JAR" CoreTestRunnerKt "$OUT/test" 2> >(filter)
