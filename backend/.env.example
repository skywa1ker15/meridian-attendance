# Meridian Attendance API — example configuration. Copy to `.env` for local development.
# NEVER commit a real .env. In staging/production supply these via the secret store /
# deploy/env/*.env; the app refuses to start there with insecure values.

APP_ENV=development                 # development | test | staging | production
LOG_LEVEL=INFO
LOG_JSON=false
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=                       # comma-separated allow-list; empty = same-origin only
TRUST_PROXY_HEADERS=false           # true only behind Caddy/nginx that sets X-Forwarded-For
SERVE_ADMIN_DASHBOARD=true
TIMEZONE=Africa/Johannesburg

DATABASE_URL=postgresql+psycopg://meridian:CHANGE_ME@127.0.0.1:5432/meridian_attendance
# TEST_DATABASE_URL=postgresql+psycopg://meridian:CHANGE_ME@127.0.0.1:5432/meridian_attendance_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
FIRST_ADMIN_SETUP_CODE=   # one-time code the Android app asks for to create the first administrator; closes once an admin exists
METRICS_TOKEN=                      # if set, /metrics requires "Authorization: Bearer <token>"

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# Push notifications (optional) — Firebase service-account JSON path, never committed
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# Play Integrity (optional)
PLAY_INTEGRITY_ENABLED=false
PLAY_INTEGRITY_PACKAGE_NAME=za.co.meridiangroup.attendance
PLAY_INTEGRITY_SERVICE_ACCOUNT_FILE=

# Email: invitations and password-reset links (see docs/EMAIL-SETUP.md).
# EMAIL_PROVIDER: auto (Graph if configured, else SMTP) | graph | smtp | none
EMAIL_PROVIDER=auto
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=Meridian Attendance
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=attendance@example.co.za
INVITATION_EXPIRY_DAYS=7
INVITATION_URL_TEMPLATE={public_base_url}/app/invite?token={token}
PASSWORD_RESET_URL_TEMPLATE={public_base_url}/app/reset?token={token}

# Android deep links (raw assetlinks.json; empty = /.well-known returns 404)
ANDROID_PACKAGE_NAME=za.co.meridiangroup.attendance
ANDROID_ASSET_LINKS_JSON=
APK_DOWNLOAD_URL=
