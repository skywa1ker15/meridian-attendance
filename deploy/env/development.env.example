# =============================================================================
# Meridian Attendance — DEVELOPMENT environment template
#
#   cp deploy/env/development.env.example deploy/env/development.env
#
# Used by deploy/docker-compose.dev.yml. The same keys can be copied to backend/.env
# when running uvicorn directly (pydantic-settings reads .env from the working directory,
# or the file named by ENV_FILE).
#
# These values are for a developer workstation only. They are rejected by the backend in
# staging/production (see validate_for_environment in backend/app/core/config.py).
# =============================================================================

# --- Application --------------------------------------------------------------
APP_NAME=Meridian Attendance API (dev)
APP_VERSION=1.0.0
APP_ENV=development
LOG_LEVEL=DEBUG
LOG_JSON=false
TIMEZONE=Africa/Johannesburg
PUBLIC_BASE_URL=http://localhost:8000
# Allow a dashboard served by a separate dev server (e.g. `npx serve admin-dashboard`), if any:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY_HEADERS=false
SERVE_ADMIN_DASHBOARD=true

# --- Database (matches docker-compose.dev.yml) --------------------------------
DATABASE_URL=postgresql+psycopg://meridian:meridian_dev@127.0.0.1:5432/meridian_attendance
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Security (weak on purpose; dev only) --------------------------------------
SECRET_KEY=dev-only-change-me-0000000000000000000000000000
JWT_ALGORITHM=HS256
# JWT_PRIVATE_KEY_PATH=
# JWT_PUBLIC_KEY_PATH=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=30
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
TEMPORARY_PASSWORD_LENGTH=12
FIRST_ADMIN_SETUP_CODE=   # one-time code the Android app asks for to create the first administrator; closes once an admin exists
METRICS_TOKEN=
IDEMPOTENCY_TTL_HOURS=24

# --- Rate limiting (relaxed so automated tests and emulators are not throttled) --
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=1000
RATE_LIMIT_LOGIN_PER_MINUTE=60
RATE_LIMIT_FORGOT_PER_MINUTE=30
RATE_LIMIT_REFRESH_PER_MINUTE=120
RATE_LIMIT_EVENTS_PER_MINUTE=300

# --- Scheduler ------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
CONFIRMATION_REMINDER_MINUTES=10

# --- Push (off; the app polls) ---------------------------------------------------
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# --- Play Integrity (off) -------------------------------------------------------
PLAY_INTEGRITY_ENABLED=false
PLAY_INTEGRITY_PACKAGE_NAME=za.co.meridiangroup.attendance
PLAY_INTEGRITY_SERVICE_ACCOUNT_FILE=

# --- Email (off; without SMTP, administrators issue temporary passwords from the dashboard) --
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=attendance@meridiangroup.co.za
PASSWORD_RESET_URL_TEMPLATE={public_base_url}/admin/#/reset-password?token={token}

# --- Observability -----------------------------------------------------------------
SENTRY_DSN=
