# =============================================================================
# Meridian Attendance — PRODUCTION environment template
#
#   cp deploy/env/production.env.example deploy/env/production.env
#   chmod 600 deploy/env/production.env
#
# deploy/env/*.env (without .example) are git-ignored. NEVER commit a filled-in copy.
# Every variable understood by the backend (backend/app/core/config.py) is listed.
# Variable names are case-insensitive for pydantic-settings; upper-case is used here.
# Placeholders look like <<...>>. The backend REFUSES to start in production when
# SECRET_KEY is weak, DATABASE_URL points at a dev database or PUBLIC_BASE_URL is not https.
# =============================================================================

# -----------------------------------------------------------------------------
# A. Compose-only variables (read by deploy/docker-compose.yml, not by the API)
# -----------------------------------------------------------------------------
DOMAIN=<<attendance.your-domain.co.za>>            # public host name; DNS A record -> this server
ACME_EMAIL=<<it-operations@your-domain.co.za>>     # Let's Encrypt expiry notices
# ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# METRICS_ALLOW_CIDR=private_ranges                 # one CIDR or 'private_ranges'; who may read /metrics via Caddy
POSTGRES_DB=meridian_attendance
POSTGRES_USER=meridian_prod
POSTGRES_PASSWORD=<<GENERATE: openssl rand -base64 32 | tr -d '/+=' >>
# API_IMAGE=ghcr.io/<<github-org>>/meridian-attendance-api:1.0.0   # use the CI-built image instead of building on the host
BACKUP_RETENTION_DAYS=35
BACKUP_HOUR_UTC=00                                 # 00:00 UTC = 02:00 Africa/Johannesburg
# BACKUP_RCLONE_REMOTE=                             # e.g. s3-backups:meridian-attendance (see scripts/backup.sh)

# -----------------------------------------------------------------------------
# B. Application
# -----------------------------------------------------------------------------
APP_NAME=Meridian Attendance API
APP_VERSION=1.0.0
APP_ENV=production                                 # development | test | staging | production
LOG_LEVEL=INFO                                     # DEBUG only when diagnosing an issue; logs contain employee ids
LOG_JSON=true                                      # JSON lines for log shipping (Loki/CloudWatch); false = human readable
TIMEZONE=Africa/Johannesburg                       # company-facing dates; storage is always UTC
PUBLIC_BASE_URL=https://<<attendance.your-domain.co.za>>   # must be https in production; used in password-reset links
# Browser origins allowed to call the API. The dashboard is served from the same origin,
# so this can stay EMPTY. Only add origins if you host the dashboard elsewhere.
CORS_ORIGINS=
TRUST_PROXY_HEADERS=true                           # true ONLY behind Caddy/nginx (compose forces this); false if the API is exposed directly
SERVE_ADMIN_DASHBOARD=true                         # serve /admin from the API container

# -----------------------------------------------------------------------------
# C. Database
# -----------------------------------------------------------------------------
# docker-compose.yml composes DATABASE_URL from POSTGRES_* above. Set it here ONLY if
# you use a managed PostgreSQL (recommended for production) and remove the db service:
# DATABASE_URL=postgresql+psycopg://<<user>>:<<password>>@<<host>>:5432/<<db>>?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false                                      # never true in production (logs every SQL statement)

# -----------------------------------------------------------------------------
# D. Security
# -----------------------------------------------------------------------------
SECRET_KEY=<<GENERATE: openssl rand -hex 32>>      # >= 32 random chars; signs JWTs (HS256). Rotating it logs everyone out.
JWT_ALGORITHM=HS256                                # HS256 (default) or RS256
# JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem   # RS256 only (mount via deploy/secrets/)
# JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=30
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
TEMPORARY_PASSWORD_LENGTH=12
FIRST_ADMIN_SETUP_CODE=<<GENERATE: openssl rand -hex 8 — give to the first admin, then remove after setup>>   # one-time code the Android app asks for to create the first administrator; closes once an admin exists
METRICS_TOKEN=<<GENERATE: openssl rand -hex 24>>   # Prometheus must send "Authorization: Bearer <token>" to /metrics; empty = unprotected (Caddy still restricts by IP)
IDEMPOTENCY_TTL_HOURS=24

# -----------------------------------------------------------------------------
# E. Rate limiting (requests per minute per client IP; in-process sliding window)
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_FORGOT_PER_MINUTE=5
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_EVENTS_PER_MINUTE=60

# -----------------------------------------------------------------------------
# F. Scheduler (expires stale pending events, flags missing clock-outs, applies retention)
# -----------------------------------------------------------------------------
SCHEDULER_ENABLED=true                             # set false if you run `python -m app.cli jobs run-once` from cron instead
SCHEDULER_INTERVAL_SECONDS=60
CONFIRMATION_REMINDER_MINUTES=10                   # reminder push if a pending confirmation is not acted on

# -----------------------------------------------------------------------------
# G. Push notifications — Firebase Cloud Messaging (HTTP v1). OPTIONAL.
#    Without FCM the app still receives everything by polling / on open.
# -----------------------------------------------------------------------------
FCM_ENABLED=false                                  # set true once the two values below are in place
FCM_PROJECT_ID=<<firebase-project-id>>             # Firebase console > Project settings > General
# Service-account JSON with role "Firebase Cloud Messaging API Admin". Save it as
# deploy/secrets/fcm-service-account.json (git-ignored); compose mounts deploy/secrets at /run/secrets.
FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json

# -----------------------------------------------------------------------------
# H. Google Play Integrity. OPTIONAL additional device signal.
# -----------------------------------------------------------------------------
PLAY_INTEGRITY_ENABLED=false
PLAY_INTEGRITY_PACKAGE_NAME=za.co.meridiangroup.attendance
PLAY_INTEGRITY_SERVICE_ACCOUNT_FILE=/run/secrets/play-integrity-service-account.json

# -----------------------------------------------------------------------------
# I. Email (invitations + password-reset links). STRONGLY RECOMMENDED — without
#    it employees cannot be invited and administrators must hand out temporary
#    passwords from the dashboard instead. See docs/EMAIL-SETUP.md.
#    EMAIL_PROVIDER: auto (Graph if configured, else SMTP) | graph | smtp | none
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=auto
# Microsoft 365 via Microsoft Graph (preferred: SMTP basic auth is being retired).
MS_GRAPH_TENANT_ID=<<entra-directory-tenant-id>>
MS_GRAPH_CLIENT_ID=<<app-registration-application-client-id>>
MS_GRAPH_CLIENT_SECRET=<<client-secret-value>>
EMAIL_SENDER_ADDRESS=attendance@<<your-domain.co.za>>
EMAIL_SENDER_NAME=Meridian Attendance
EMAIL_TIMEOUT_SECONDS=15
# SMTP fallback (any other provider). Leave SMTP_HOST empty when using Graph.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=attendance@<<your-domain.co.za>>
INVITATION_EXPIRY_DAYS=7
INVITATION_URL_TEMPLATE={public_base_url}/app/invite?token={token}
PASSWORD_RESET_URL_TEMPLATE={public_base_url}/app/reset?token={token}
RATE_LIMIT_EMAIL_TEST_PER_MINUTE=3

# -----------------------------------------------------------------------------
# I2. Android deep links. OPTIONAL — lets the emailed links open the app itself.
#     ANDROID_ASSET_LINKS_JSON is the raw contents of assetlinks.json (one line);
#     empty means /.well-known/assetlinks.json returns 404.
# -----------------------------------------------------------------------------
ANDROID_ASSET_LINKS_JSON=
APK_DOWNLOAD_URL=

# -----------------------------------------------------------------------------
# J. Observability. OPTIONAL.
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://<<key>>@<<org>>.ingest.sentry.io/<<project>>
